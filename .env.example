# Finance Transaction Manager - Environment Variables
# Copy this file to .env and fill in your values

# =============================================================================
# REQUIRED FOR AI FEATURES
# =============================================================================

# OpenAI API Key (required for AI Assistant and AI-Powered Insights)
# Get your key from: https://platform.openai.com/api-keys
OPENAI_API_KEY=sk-your-api-key-here

# =============================================================================
# SUPABASE (tietokanta)
# =============================================================================

# Supabase-projektin URL (Settings → API)
SUPABASE_URL=https://xxxx.supabase.co

# Service role key — vain migraatioskripteissä ja MCP-palvelimessa
# EI koskaan frontendissä / Streamlitissä
SUPABASE_SERVICE_KEY=eyJ...

# Anon key — Streamlit-dashboardissa (rajoitetut oikeudet)
SUPABASE_ANON_KEY=eyJ...

# =============================================================================
# OPTIONAL SETTINGS
# =============================================================================

# Default path to your CSV file (optional)
# DEFAULT_CSV_PATH=/path/to/your/Transactions.csv
